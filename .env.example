# Application flags only. PowerShell: $env:FINOPS_ENABLE_LIVE = 'false'
# .env is not automatically loaded.
FINOPS_ENABLE_LIVE=false
FINOPS_DB=data/finops.db
FINOPS_VAULT_DIR=data/credentials

# Bedrock is independent of cloud billing sync. No inference until BOTH the
# operator enables this flag AND the individual client administrator approves.
FINOPS_ENV=local
FINOPS_BEDROCK_ENABLED=false
FINOPS_BEDROCK_REGION=ap-south-1
FINOPS_BEDROCK_MODEL_ID=global.anthropic.claude-opus-5-5
FINOPS_BEDROCK_TARGET_TYPE=inference_profile
# Operator permits the capability; this does not approve any client's transfer.
FINOPS_BEDROCK_ALLOW_GLOBAL=true
FINOPS_BEDROCK_REQUIRE_GUARDRAIL=true
FINOPS_BEDROCK_GUARDRAIL_ID=
FINOPS_BEDROCK_GUARDRAIL_VERSION=
FINOPS_BEDROCK_NATIVE_JSON=true
